# ==============================================================================
# Teleflow Agent v2.0.0 — Environment Variables Template
# ==============================================================================

# --- Telegram Bot Credentials ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-numeric-chat-id
TELEGRAM_WEBHOOK_SECRET=your-32-char-random-secret

# --- AI Intelligence & RAG Grounding ---
# Google Gemini API Key (Gemini 2.5 Flash)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# SutraDB Vector & BM25 Hybrid Knowledge Retrieval Server
SUTRADB_URL=http://localhost:8765
SUTRADB_COLLECTION=portfolio_kb

# --- CRM & Database Sinks ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional External Webhook Sink (Zapier, Make, n8n, Slack)
EXTERNAL_CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
EXTERNAL_CRM_WEBHOOK_SECRET=your-webhook-hmac-secret

# --- Scheduling & Cal.com Bridge ---
CAL_BOOKING_URL=https://cal.com/sam-codesai

# --- Runtime Configuration ---
PORT=3000
NODE_ENV=production
TELEFLOW_MODE=webhook # Options: webhook | polling
