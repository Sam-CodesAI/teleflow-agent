{
  "name": "teleflow-agent",
  "version": "1.2.0",
  "description": "Autonomous Telegram Lead Qualification Agent & Edge CRM Router — State-machine reasoning, interactive inline keyboards, Cal.com scheduling bridge, and multi-sink synchronization.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "poll": "tsx src/index.ts --poll",
    "test": "node --test dist/tests/**/*.test.js || tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t teleflow-agent .",
    "docker:run": "docker run -p 3000:3000 --env-file .env teleflow-agent"
  },
  "keywords": [
    "telegram-bot",
    "ai-agent",
    "lead-qualification",
    "agentic-workflow",
    "crm-automation",
    "cal-com-integration",
    "interactive-keyboards",
    "edge-runtime",
    "typescript",
    "supabase",
    "serverless"
  ],
  "author": "Samarth Nimangre <samarthknimangre@gmail.com> (https://sam-codes.vercel.app)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sam-CodesAI/teleflow-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Sam-CodesAI/teleflow-agent/issues"
  },
  "homepage": "https://sam-codes.vercel.app",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
